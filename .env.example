# ==============================================================================
# SMART FARM MINI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Mẫu tham khảo cho các công cụ phát triển/compose. ASP.NET Core không tự nạp file .env;
# dùng `dotnet user-secrets` cho local hoặc khai báo biến ConnectionStrings__... / JwtSettings__...
# trong môi trường chạy backend.
# LƯU Ý: Tuyệt đối KHÔNG commit file chứa secret thật lên Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# ASP.NET Core Runtime Configuration
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5205;https://localhost:7272

# ------------------------------------------------------------------------------
# Database Connection (Microsoft SQL Server)
# ------------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Server=localhost;Database=SmartFarmMiniDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# ------------------------------------------------------------------------------
# MQTT Broker Configuration (Mosquitto)
# ------------------------------------------------------------------------------
# Backend reads these ASP.NET Core configuration keys (or set them with
# `dotnet user-secrets set "Mqtt:Host" ...`). This is the broker address
# from the backend machine. If Mosquitto runs on this same laptop, use 127.0.0.1.
# Keep MQTT disabled until the broker credentials below are replaced locally.
Mqtt__Enabled=false
Mqtt__Host=127.0.0.1
Mqtt__Port=1883
Mqtt__Username=backend_farm
Mqtt__Password=REPLACE_WITH_YOUR_BACKEND_PASSWORD
Mqtt__ClientId=SmartFarm-WebAPI
Mqtt__UseTls=false
# Configure the ESP32 separately in firmware/esp32-controller/telemetry/include/config.h.
# For ESP32, MqttHost must be the laptop's LAN IPv4 address, not 127.0.0.1.

# ------------------------------------------------------------------------------
# JWT Authentication Configuration
# ------------------------------------------------------------------------------
# Configure JwtSettings__SecretKey via user-secrets or the runtime environment.
JwtSettings__Issuer=SmartFarm.API
JwtSettings__Audience=SmartFarm.Client
JwtSettings__AccessTokenExpiryMinutes=15
JwtSettings__RefreshTokenExpiryDays=30
