# ==============================================================================
# SMART FARM MINI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Mẫu tham khảo cho các công cụ phát triển/compose. ASP.NET Core không tự nạp file .env;
# dùng `dotnet user-secrets` cho local hoặc khai báo biến ConnectionStrings__... / JwtSettings__...
# trong môi trường chạy backend.
# LƯU Ý: Tuyệt đối KHÔNG commit file chứa secret thật lên Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# ASP.NET Core Runtime Configuration
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5205;https://localhost:7272

# ------------------------------------------------------------------------------
# Database Connection (Microsoft SQL Server)
# ------------------------------------------------------------------------------
# Mẫu kết nối Local SQL Server với Windows Authentication hoặc SQL Auth
DB_CONNECTION_STRING=Server=localhost;Database=SmartFarmMiniDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
# Mẫu dùng SQL Authentication:
# DB_CONNECTION_STRING=Server=localhost,1433;Database=SmartFarmMiniDb;User Id=sa;Password=YourStrong@Password;TrustServerCertificate=True

# ------------------------------------------------------------------------------
# MQTT Broker Configuration (EMQX / Mosquitto)
# ------------------------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=SmartFarm_Backend_Server

# ------------------------------------------------------------------------------
# JWT Authentication Configuration (Dành cho Issue #7)
# ------------------------------------------------------------------------------
# Key phải có độ dài tối thiểu 32 ký tự (256-bit) cho thuật toán HMAC-SHA256
JWT_KEY=Your_Secret_Key_For_JWT_Authentication_Minimum_32_Chars!
JWT_ISSUER=SmartFarm.API
JWT_AUDIENCE=SmartFarm.Client
JWT_EXPIRATION_MINUTES=60

